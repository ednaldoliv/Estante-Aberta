# PostgreSQL / Neon connection URL. Do not commit a real credential.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Token signing key. Generate a unique value with at least 32 random characters.
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# Local development defaults.
PORT=3001
VITE_API_URL="http://localhost:3001/api"

# SMTP de exemplo; substitua pelos dados do serviço escolhido.
FRONTEND_URL="http://localhost:3000"
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER="usuario-exemplo"
SMTP_PASSWORD="senha-exemplo"
SMTP_FROM="Estante Aberta <nao-responda@example.com>"
