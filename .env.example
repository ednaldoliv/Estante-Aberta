# PostgreSQL / Neon connection URL. Do not commit a real credential.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Administrative access configuration. Use a strong value in the deployed environment.
ADMIN_ACCESS_KEY="replace-with-a-strong-secret"

# Local development defaults.
PORT=3001
VITE_API_URL="http://localhost:3001/api"
